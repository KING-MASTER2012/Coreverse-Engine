---
Language: Cpp
Standard: Latest
# clang-format's Standard enum tops out at "c++20" as of LLVM 18 —
# there is no "c++23" value, and setting one is a hard parse error
# (confirmed against clang-format 18.1.3). "Latest" is the correct,
# version-proof choice: it always resolves to whatever standard the
# installed clang-format understands most recently, so it tracks
# C++23 automatically on any clang-format new enough to know about it.

BasedOnStyle: LLVM
IndentWidth: 4
TabWidth: 4
UseTab: Never
ColumnLimit: 120

AccessModifierOffset: -4
NamespaceIndentation: None
IndentCaseLabels: true
IndentPPDirectives: BeforeHash

BreakBeforeBraces: Custom
BraceWrapping:
    AfterClass: true
    AfterStruct: false
    AfterUnion: true
    AfterEnum: false
    AfterFunction: true
    AfterNamespace: false
    AfterControlStatement: false
    AfterExternBlock: false
    BeforeElse: false
    BeforeCatch: false
    SplitEmptyFunction: false
    SplitEmptyRecord: false
    SplitEmptyNamespace: false

PointerAlignment: Left
ReferenceAlignment: Left
DerivePointerAlignment: false

AlignAfterOpenBracket: BlockIndent
AlignConsecutiveAssignments: false
AlignConsecutiveDeclarations: false
AlignOperands: Align
AlignTrailingComments: true

AllowShortFunctionsOnASingleLine: Empty
AllowShortIfStatementsOnASingleLine: Never
AllowShortLoopsOnASingleLine: false
AllowShortBlocksOnASingleLine: Never

BinPackArguments: false
BinPackParameters: false

SortIncludes: CaseSensitive
IncludeBlocks: Regroup
IncludeCategories:
    - Regex: '^"cv_ffi/'          # Rust C-ABI boundary header first
      Priority: 1
    - Regex: '^<Qt'                # Qt
      Priority: 3
    - Regex: '^<(vulkan|volk|vk_mem_alloc)'  # Vulkan/VMA
      Priority: 4
    - Regex: '^<'                  # other system/third-party headers
      Priority: 2
    - Regex: '.*'                  # project-local headers last
      Priority: 5

SpaceBeforeParens: ControlStatements
SpacesInAngles: false
Cpp11BracedListStyle: true

FixNamespaceComments: true
ReflowComments: true
