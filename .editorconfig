root = true

# Default rules for all files
[*]
charset = utf-8
end_of_line = lf
trim_trailing_whitespace = true
insert_final_newline = true
indent_style = space
indent_size = 4

# Web and Config (React, TS, JSON, YAML)
[*.{js,jsx,ts,tsx,json,yml,yaml,md,html,css}]
indent_size = 2

# Go Language
[*.go]
indent_style = tab

# Makefile
[{Makefile,*.mk}]
indent_style = tab

# Windows Scripts
[*.{bat,cmd}]
end_of_line = crlf